digraph MothXArchitecture {
    rankdir=TB;
    bgcolor="transparent";
    node [shape=box, style="rounded,filled", fontname="Arial", fontsize=12, margin="0.15,0.08"];
    edge [fontname="Arial", fontsize=10, color="#6366f1"];

    // Title
    title [label="MothX 架构总览", shape=plaintext, fontsize=18, fontcolor="#3730a3"];

    // Input Layer
    subgraph cluster_input {
        label="入口层 (Entry Points)";
        style="rounded,filled";
        fillcolor="#e0e7ff";
        color="#6366f1";
        fontsize=13;
        tui [label="🖥️ TUI 终端\n(BubbleTea + Lipgloss)", fillcolor="#c7d2fe"];
        cli [label="⌨️ CLI 命令行\n(Cobra)", fillcolor="#c7d2fe"];
        acp [label="💻 ACP 协议\n(VS Code/Zed/JetBrains)", fillcolor="#c7d2fe"];
        serve [label="🌐 Serve 网关\n(OpenAI API + Web UI)", fillcolor="#c7d2fe"];
        channels [label="📱 消息通道\n(微信/飞书/WS)", fillcolor="#c7d2fe"];
    }

    // Core Layer
    subgraph cluster_core {
        label="核心引擎 (Core Engine)";
        style="rounded,filled";
        fillcolor="#fef3c7";
        color="#f59e0b";
        fontsize=13;
        agent [label="🤖 Agent 循环\n系统提示 + 流式 + 工具调度", fillcolor="#fde68a"];
        context [label="🧠 上下文管理\n窗口压缩 + Token 估算", fillcolor="#fde68a"];
        tools [label="🛠️ 工具系统\nread/write/edit/bash/grep...", fillcolor="#fde68a"];
        esm [label="👁️ ESM 监督\nWorker/Critic/Audit", fillcolor="#fde68a"];
    }

    // Provider Layer
    subgraph cluster_provider {
        label="提供商抽象 (Provider Abstraction)";
        style="rounded,filled";
        fillcolor="#d1fae5";
        color="#10b981";
        fontsize=13;
        factory [label="🏭 Provider Factory\n统一创建 + 厂商检测", fillcolor="#a7f3d0"];
        providers [label="DeepSeek | OpenAI | Anthropic\nGoogle | 豆包 | Kimi | 25+ 厂商", fillcolor="#a7f3d0"];
    }

    // Infrastructure Layer
    subgraph cluster_infra {
        label="基础设施 (Infrastructure)";
        style="rounded,filled";
        fillcolor="#fee2e2";
        color="#ef4444";
        fontsize=13;
        session [label="💾 SQLite 会话\n树形/分支/压缩", fillcolor="#fecaca"];
        sandbox [label="🛡️ bwrap 沙箱\n进程级隔离", fillcolor="#fecaca"];
        skills [label="🧩 技能系统\nSKILL.md + SkillHub", fillcolor="#fecaca"];
        mcp [label="🔌 MCP 集成\n外部工具协议", fillcolor="#fecaca"];
        stats [label="📊 统计面板\nToken/费用/趋势", fillcolor="#fecaca"];
        memory [label="📝 持久记忆\nmemory.md", fillcolor="#fecaca"];
        workflow [label="🔄 工作流引擎\nJavaScript DSL 编排", fillcolor="#fecaca"];
    }

    // Connections
    tui -> agent;
    cli -> agent;
    acp -> agent;
    serve -> agent;
    channels -> agent;

    agent -> context;
    agent -> tools;
    agent -> esm;
    agent -> factory;

    factory -> providers;

    tools -> sandbox [label="安全执行"];
    tools -> session [label="读写历史"];
    tools -> mcp [label="外部工具"];

    agent -> session [label="会话持久化"];
    agent -> skills [label="提示注入"];
    agent -> memory [label="长期记忆"];
    agent -> stats [label="用量记录"];
    esm -> workflow [label="多Agent编排"];

    providers -> stats [label="Token统计"];
}
